          "j + ī → jī（鸡）",
          "q + ì → qì（气）",
          "x + ī → xī（西）",
          "j + ǘ → jú（菊）"
        ],
        "rule": "ü和j、q、x相拼，两点省去，读音不变；不要读成u。"
      },
      {
        "id": "lesson-7",
        "number": 7,
        "unit": 3,
        "symbols": [
          "z",
          "c",
          "s"
