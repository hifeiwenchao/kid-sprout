          "ō ó ǒ ò",
          "ē é ě è"
        ],
        "rule": "四声小帽子标在韵母上：一声平，二声扬，三声拐弯，四声降。"
      },
      {
        "id": "lesson-2",
        "number": 2,
        "unit": 2,
        "symbols": [
          "i",
          "u",
          "ü"
        ],
        "title": "i u ü",
        "readSyllables": [],
        "spellings": [
          "ī í ǐ ì",
          "ū ú ǔ ù",
          "ǖ ǘ ǚ ǜ"
        ],
        "rule": "i戴上声调帽子时去掉小点；ü的两点要保留。"
      },
      {
        "id": "lesson-3",
        "number": 3,
        "unit": 2,
        "symbols": [
          "b",
          "p",
          "m",
          "f"
        ],
        "title": "b p m f",
        "readSyllables": [],
        "spellings": [
          "b + ā → bā（八）",
          "p + á → pá（爬）",
          "m + ǎ → mǎ（马）",
          "f + à → fà（发）"
        ],
        "rule": "前面的声母轻而短，后面的韵母响而长，紧紧连起来。"
      },
      {
        "id": "lesson-4",
        "number": 4,
        "unit": 2,
        "symbols": [
          "d",
          "t",
          "n",
          "l"
        ],
        "title": "d t n l",
        "readSyllables": [],
        "spellings": [
          "d + à → dà（大）",
          "t + ǔ → tǔ（土）",
          "n + ǚ → nǚ（女）",
          "l + ǜ → lǜ（绿）"
        ],
        "rule": "n、l和ü相拼时，ü的两点保留下来。"
      },
      {
        "id": "lesson-5",
        "number": 5,
        "unit": 3,
        "symbols": [
          "g",
          "k",
          "h"
        ],
        "title": "g k h",
        "readSyllables": [],
        "spellings": [
          "g + ē → gē（哥）",
          "k + ǒu → kǒu（口）",
          "h + é → hé（河）",
          "g + u + ā → guā（瓜）"
        ],
        "rule": "三拼音节中，声母、介母、韵母连续拼出来：g—u—ā，guā。"
      },
      {
        "id": "lesson-6",
        "number": 6,
        "unit": 3,
        "symbols": [
          "j",
          "q",
          "x"
        ],
        "title": "j q x",
        "readSyllables": [],
